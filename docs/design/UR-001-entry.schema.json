{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mskrad/Epochnotes/docs/design/UR-001-entry.schema.json",
  "title": "Registry entry (design draft, schema_version 1)",
  "description": "Design artifact of UR-001. The implementation schema is generated from zod in UR-003 and must stay equivalent to this file.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "rev", "axis", "subject", "applies", "breaks", "fix", "sources"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 64 },
    "rev": { "type": "integer", "minimum": 1 },
    "axis": { "enum": ["protocol", "client", "library"] },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "name", "title"],
      "properties": {
        "type": { "enum": ["simd", "client-release", "package"] },
        "name": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 }
      }
    },
    "applies": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "gates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["address", "label"],
            "properties": {
              "address": { "type": "string", "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$" },
              "label": { "type": "string", "minLength": 1 },
              "effect": { "type": "string" }
            }
          }
        },
        "versions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ecosystem", "name", "range"],
            "properties": {
              "ecosystem": { "enum": ["npm", "cargo", "client"] },
              "name": { "type": "string", "minLength": 1 },
              "range": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "id"],
        "properties": {
          "type": { "enum": ["requires", "supersedes", "related"] },
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
        }
      }
    },
    "breaks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["surface", "summary"],
        "properties": {
          "surface": { "enum": ["rpc", "decoder", "stream", "program", "sdk", "wallet", "economics"] },
          "summary": { "type": "string", "minLength": 1 },
          "evidence": { "type": "array", "items": { "type": "integer", "minimum": 0 }, "description": "Indexes into sources[]" }
        }
      }
    },
    "detect": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule", "kind", "confidence", "summary"],
        "properties": {
          "rule": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "kind": { "enum": ["code-pattern", "lockfile-version", "runtime-probe"] },
          "confidence": { "enum": ["breaks", "check", "likely-ok"] },
          "summary": { "type": "string", "minLength": 1 },
          "languages": { "type": "array", "items": { "enum": ["ts", "js", "rust", "python", "go"] } },
          "pattern": { "type": "string" },
          "package": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ecosystem", "name", "range"],
            "properties": {
              "ecosystem": { "enum": ["npm", "cargo"] },
              "name": { "type": "string" },
              "range": { "type": "string" }
            }
          },
          "probe": {
            "type": "object",
            "additionalProperties": false,
            "required": ["method", "expect"],
            "properties": {
              "method": { "type": "string" },
              "fixture": { "type": "string" },
              "expect": { "type": "string" }
            }
          }
        },
        "oneOf": [
          { "properties": { "kind": { "const": "code-pattern" } }, "required": ["pattern", "languages"] },
          { "properties": { "kind": { "const": "lockfile-version" } }, "required": ["package"] },
          { "properties": { "kind": { "const": "runtime-probe" } }, "required": ["probe"] }
        ]
      }
    },
    "fix": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["summary"],
        "properties": {
          "summary": { "type": "string", "minLength": 1 },
          "detail": { "type": "string" },
          "for_rules": { "type": "array", "items": { "type": "string" } },
          "links": { "type": "array", "items": { "type": "string", "format": "uri" } }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "ref", "retrieved"],
        "properties": {
          "kind": { "enum": ["simd", "source-code", "release", "rpc-observation", "issue", "docs"] },
          "ref": { "type": "string", "minLength": 1 },
          "retrieved": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "note": { "type": "string" }
        }
      }
    }
  }
}
