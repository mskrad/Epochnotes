{
  "name": "epochnotes",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "lint": "npm run typecheck:tests && eslint . && prettier --check . && node scripts/check-language.mjs",
    "format": "prettier --write .",
    "build:program": "anchor build",
    "verify:ts": "npm run build && npm run test && npm run lint",
    "verify": "npm run verify:ts && npm run build:program",
    "schema:write": "npm run build && node scripts/write-schema.mjs && prettier --write registry/schema.json",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "e2e": "npm run build && node scripts/e2e.mjs",
    "corpus:check": "npm run build && node scripts/check-corpus.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@types/semver": "^7.8.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.10.0",
    "prettier": "^3.9.8",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "verifiable-outcome-sdk": "^0.9.1",
    "vitest": "^5.0.1"
  }
}
