{
  "$id": "https://github.com/mskrad/Epochnotes/registry/schema.json",
  "title": "Registry entry (schema_version 1)",
  "description": "Format of one registry entry. Activation status is never stored in an entry: it is read from the feature gate account at check time.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "rev": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "axis": {
      "type": "string",
      "enum": ["protocol", "client", "library"]
    },
    "subject": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["simd", "client-release", "package"]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["type", "name", "title"],
      "additionalProperties": false
    },
    "applies": {
      "type": "object",
      "properties": {
        "gates": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "address": {
                "type": "string",
                "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "effect": {
                "type": "string"
              }
            },
            "required": ["address", "label"],
            "additionalProperties": false
          }
        },
        "versions": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ecosystem": {
                "type": "string",
                "enum": ["npm", "cargo", "client"]
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "range": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["ecosystem", "name", "range"],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false,
      "minProperties": 1
    },
    "relations": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": ["requires", "supersedes", "related"]
          },
          "id": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          }
        },
        "required": ["type", "id"],
        "additionalProperties": false
      }
    },
    "breaks": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "surface": {
            "type": "string",
            "enum": ["rpc", "decoder", "stream", "program", "sdk", "wallet", "economics"]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        "required": ["surface", "summary"],
        "additionalProperties": false
      }
    },
    "detect": {
      "default": [],
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "rule": {
                "type": "string",
                "maxLength": 64,
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "confidence": {
                "type": "string",
                "enum": ["breaks", "check", "likely-ok"]
              },
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "const": "code-pattern"
              },
              "languages": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": ["ts", "js", "rust", "python", "go", "markdown"]
                }
              },
              "pattern": {
                "type": "string",
                "minLength": 1,
                "description": "A JavaScript regular expression, run over the whole text of a file with the flags g and m, after Windows line endings are turned into \\n. ^ and $ mean a line; . does not cross a line; \\s and negated classes do, so that a line break inside a match does not hide it. One finding is reported per rule and starting line. Keep quantifiers bounded by the line where you can: an unbounded negated class is matched against up to one MiB of text."
              }
            },
            "required": ["rule", "confidence", "summary", "kind", "languages", "pattern"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "rule": {
                "type": "string",
                "maxLength": 64,
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "confidence": {
                "type": "string",
                "enum": ["breaks", "check", "likely-ok"]
              },
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "const": "lockfile-version"
              },
              "package": {
                "type": "object",
                "properties": {
                  "ecosystem": {
                    "type": "string",
                    "enum": ["npm", "cargo"]
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "range": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["ecosystem", "name", "range"],
                "additionalProperties": false
              }
            },
            "required": ["rule", "confidence", "summary", "kind", "package"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "rule": {
                "type": "string",
                "maxLength": 64,
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "confidence": {
                "type": "string",
                "enum": ["breaks", "check", "likely-ok"]
              },
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "const": "runtime-probe"
              },
              "probe": {
                "type": "object",
                "properties": {
                  "method": {
                    "type": "string",
                    "minLength": 1
                  },
                  "fixture": {
                    "description": "The transaction a probe reads, as <cluster>:<signature>. The probe runs only against an endpoint that serves that cluster.",
                    "type": "string",
                    "pattern": "^(mainnet-beta|testnet|devnet):[1-9A-HJ-NP-Za-km-z]{64,128}$"
                  },
                  "expect": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["method", "expect"],
                "additionalProperties": false
              }
            },
            "required": ["rule", "confidence", "summary", "kind", "probe"],
            "additionalProperties": false
          }
        ]
      }
    },
    "fix": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "detail": {
            "type": "string"
          },
          "for_rules": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            }
          },
          "links": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
          }
        },
        "required": ["summary"],
        "additionalProperties": false
      }
    },
    "sources": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["simd", "source-code", "release", "rpc-observation", "issue", "docs"]
          },
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "retrieved": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "note": {
            "type": "string"
          }
        },
        "required": ["kind", "ref", "retrieved"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schema_version", "id", "rev", "axis", "subject", "applies", "breaks", "fix", "sources"],
  "additionalProperties": false
}
