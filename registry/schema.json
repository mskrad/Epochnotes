{
  "$id": "https://github.com/mskrad/Epochnotes/registry/schema.json",
  "title": "Registry entry (schema_version 2)",
  "description": "Format of one registry entry. Activation status is never stored in an entry: it is read from the chain at check time. Readers also accept schema_version 1, which versions signed before schema 2 contain.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 2
    },
    "id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "rev": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "axis": {
      "type": "string",
      "enum": ["protocol", "client", "library"]
    },
    "subject": {
      "type": "object",
      "properties": {
        "standard": {
          "type": "string",
          "enum": ["simd", "eip", "bep", "bip", "aip", "sip", "client-release", "package"]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "The id people use for it: SIMD-0385, EIP-7702, @solana/kit."
        },
        "title": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["standard", "name", "title"],
      "additionalProperties": false
    },
    "applies": {
      "type": "object",
      "properties": {
        "activations": {
          "minItems": 1,
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "feature-account"
                  },
                  "chain": {
                    "type": "string",
                    "const": "solana",
                    "description": "The namespace, not one cluster: a feature account has the same address on every Solana cluster, and its state is read from the cluster asked about."
                  },
                  "address": {
                    "type": "string",
                    "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "description": "The name the client source gives the change: a feature module, a fork name."
                  },
                  "effect": {
                    "type": "string"
                  }
                },
                "required": ["kind", "chain", "address", "label"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "timestamp"
                  },
                  "chain": {
                    "type": "string",
                    "pattern": "^eip155:[1-9][0-9]{0,31}$"
                  },
                  "at": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991,
                    "description": "Unix time, in seconds, of the first block that carries the change."
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "description": "The name the client source gives the change: a feature module, a fork name."
                  },
                  "effect": {
                    "type": "string"
                  },
                  "evidence": {
                    "description": "How a block shows the fork, so that its activation is observed rather than taken from the time.",
                    "type": "object",
                    "properties": {
                      "header": {
                        "type": "string",
                        "minLength": 1,
                        "description": "A block header field that exists only from this fork on, such as requestsHash."
                      }
                    },
                    "required": ["header"],
                    "additionalProperties": false
                  }
                },
                "required": ["kind", "chain", "at", "label"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "block-height"
                  },
                  "chain": {
                    "type": "string",
                    "pattern": "^(?!solana:)[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,32}$"
                  },
                  "at": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991,
                    "description": "The first block that carries the change."
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "description": "The name the client source gives the change: a feature module, a fork name."
                  },
                  "effect": {
                    "type": "string"
                  }
                },
                "required": ["kind", "chain", "at", "label"],
                "additionalProperties": false
              }
            ]
          }
        },
        "versions": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ecosystem": {
                "type": "string",
                "enum": ["npm", "cargo", "client"]
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "range": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["ecosystem", "name", "range"],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false,
      "minProperties": 1
    },
    "relations": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": ["requires", "supersedes", "related"]
          },
          "id": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          }
        },
        "required": ["type", "id"],
        "additionalProperties": false
      }
    },
    "breaks": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "surface": {
            "type": "string",
            "enum": ["rpc", "decoder", "stream", "program", "sdk", "wallet", "economics"],
            "description": "Where it breaks. `program` is code that runs on chain: a Solana program, an EVM contract."
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        "required": ["surface", "summary"],
        "additionalProperties": false
      }
    },
    "detect": {
      "default": [],
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "rule": {
                "type": "string",
                "maxLength": 64,
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "confidence": {
                "type": "string",
                "enum": ["breaks", "check", "likely-ok"]
              },
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "const": "code-pattern"
              },
              "languages": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": ["ts", "js", "rust", "python", "go", "markdown", "solidity"]
                }
              },
              "pattern": {
                "type": "string",
                "minLength": 1,
                "description": "A JavaScript regular expression, run over the whole text of a file with the flags g and m, after Windows line endings are turned into \\n. ^ and $ mean a line; . does not cross a line; \\s and negated classes do, so that a line break inside a match does not hide it. One finding is reported per rule and starting line. Keep quantifiers bounded by the line where you can: an unbounded negated class is matched against up to one MiB of text."
              }
            },
            "required": ["rule", "confidence", "summary", "kind", "languages", "pattern"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "rule": {
                "type": "string",
                "maxLength": 64,
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "confidence": {
                "type": "string",
                "enum": ["breaks", "check", "likely-ok"]
              },
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "const": "lockfile-version"
              },
              "package": {
                "type": "object",
                "properties": {
                  "ecosystem": {
                    "type": "string",
                    "enum": ["npm", "cargo"]
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "range": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["ecosystem", "name", "range"],
                "additionalProperties": false
              }
            },
            "required": ["rule", "confidence", "summary", "kind", "package"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "rule": {
                "type": "string",
                "maxLength": 64,
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "confidence": {
                "type": "string",
                "enum": ["breaks", "check", "likely-ok"]
              },
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "const": "runtime-probe"
              },
              "probe": {
                "type": "object",
                "properties": {
                  "fixture": {
                    "type": "string",
                    "pattern": "^(?:(?:solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp|solana:4uhcVJyU9pJkvQyS88uRDiswHXSCkY3z|solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1):[1-9A-HJ-NP-Za-km-z]{64,128}|(?:eip155:1|eip155:8453):0x[0-9a-fA-F]{64})$",
                    "description": "The transaction a probe reads, as <CAIP-2 chain>:<id>. The probe runs only against an endpoint that serves that chain."
                  },
                  "calls": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "maxLength": 64,
                          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
                          "description": "How the observations and the pass conditions name this call."
                        },
                        "method": {
                          "type": "string",
                          "enum": [
                            "getTransaction",
                            "getBlock",
                            "getSignaturesForAddress",
                            "getAccountInfo",
                            "getMultipleAccounts",
                            "getSlot",
                            "getBlockHeight",
                            "getVersion",
                            "getGenesisHash",
                            "eth_getTransactionByHash",
                            "eth_getTransactionReceipt",
                            "eth_getBlockByNumber",
                            "eth_getBlockByHash",
                            "eth_getCode",
                            "eth_getBalance",
                            "eth_getStorageAt",
                            "eth_blockNumber",
                            "eth_chainId"
                          ],
                          "description": "A JSON-RPC method that only reads: a probe never sends, signs or simulates."
                        },
                        "params": {
                          "default": [],
                          "description": "Parameters; the string $fixture stands for the transaction id.",
                          "type": "array",
                          "items": {}
                        }
                      },
                      "required": ["id", "method"],
                      "additionalProperties": false
                    }
                  },
                  "observe": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^(?:result|error)(?:\\.[A-Za-z_][A-Za-z0-9_]*)*$"
                    },
                    "description": "What to record from every answer."
                  },
                  "pass": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "call": {
                          "type": "string",
                          "maxLength": 64,
                          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                        },
                        "path": {
                          "type": "string",
                          "pattern": "^(?:result|error)(?:\\.[A-Za-z_][A-Za-z0-9_]*)*$"
                        },
                        "equals": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "integer",
                              "minimum": -9007199254740991,
                              "maximum": 9007199254740991
                            },
                            {
                              "type": "boolean"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      },
                      "required": ["call", "path", "equals"],
                      "additionalProperties": false
                    },
                    "description": "The endpoint behaves as the entry says when every condition holds."
                  },
                  "expect": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["fixture", "calls", "observe", "pass", "expect"],
                "additionalProperties": false
              }
            },
            "required": ["rule", "confidence", "summary", "kind", "probe"],
            "additionalProperties": false
          }
        ]
      }
    },
    "fix": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "detail": {
            "type": "string"
          },
          "for_rules": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            }
          },
          "links": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
          }
        },
        "required": ["summary"],
        "additionalProperties": false
      }
    },
    "sources": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["simd", "proposal", "source-code", "release", "rpc-observation", "issue", "docs"]
          },
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "retrieved": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "note": {
            "type": "string"
          }
        },
        "required": ["kind", "ref", "retrieved"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schema_version", "id", "rev", "axis", "subject", "applies", "breaks", "fix", "sources"],
  "additionalProperties": false
}
